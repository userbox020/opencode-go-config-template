{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode-go"
  ],
  "model": "opencode-go/qwen3.8-flash",
  "small_model": "opencode-go/longcat-2.0",
  "default_agent": "orchestrator",
  "plugin": [
    "oh-my-opencode-slim@2.2.17"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "instructions": [
    ".opencode/oh-my-opencode-slim/project-instructions.md"
  ],
  "agent": {
    "build": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "plan": {
      "model": "opencode-go/glm-5.3-flash",
      "variant": "max"
    },
    "general": {
      "model": "opencode-go/qwen3.8-flash",
      "variant": "medium"
    },
    "explore": {
      "model": "opencode-go/longcat-2.0",
      "variant": "medium"
    },
    "title": {
      "model": "opencode-go/longcat-2.0",
      "variant": "low"
    },
    "summary": {
      "model": "opencode-go/longcat-2.0",
      "variant": "low"
    },
    "compaction": {
      "model": "opencode-go/longcat-2.0",
      "variant": "low"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 6
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "ask",
      ".env.*": "ask",
      "**/.env": "ask",
      "**/.env.*": "ask",
      ".env.example": "allow",
      "**/.env.example": "allow",
      ".npmrc": "ask",
      "**/.npmrc": "ask",
      ".pypirc": "ask",
      "**/.pypirc": "ask",
      ".netrc": "ask",
      "**/.netrc": "ask",
      "credentials": "ask",
      "**/credentials": "ask",
      "secrets.*": "ask",
      "**/secrets.*": "ask",
      "*.key": "ask",
      "*.pem": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*keypair*.json": "ask",
      "*private-key*.json": "ask",
      "rpc_endpoints.txt": "ask",
      "graphql_endpoints.txt": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".pypirc": "deny",
      "**/.pypirc": "deny",
      ".netrc": "deny",
      "**/.netrc": "deny",
      "credentials": "deny",
      "**/credentials": "deny",
      "secrets.*": "deny",
      "**/secrets.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*keypair*.json": "deny",
      "*private-key*.json": "deny",
      "rpc_endpoints.txt": "deny",
      "graphql_endpoints.txt": "deny"
    },
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "rm -rf *": "ask",
      "Remove-Item * -Recurse *": "ask",
      "npm publish": "ask",
      "npm publish *": "ask",
      "pnpm publish": "ask",
      "pnpm publish *": "ask",
      "yarn npm publish *": "ask",
      "docker push *": "ask",
      "kubectl *": "ask",
      "terraform apply": "ask",
      "terraform apply *": "ask",
      "pulumi up": "ask",
      "pulumi up *": "ask",
      "cast send *": "ask",
      "cast publish *": "ask",
      "cast wallet *": "ask",
      "forge create *": "ask",
      "forge script *--broadcast*": "ask",
      "forge script * --broadcast *": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  }
}
